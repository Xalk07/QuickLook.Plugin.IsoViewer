<UserControl x:Class="QuickLook.Plugin.IsoViewer.IsoFolderPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QuickLook.Plugin.IsoViewer"
             Background="{DynamicResource MainWindowBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="8,4" Background="#22000000">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="totalSize" Margin="0,0,16,0" Opacity="0.85"/>
                <TextBlock x:Name="numFolders" Margin="0,0,16,0" Opacity="0.85"/>
                <TextBlock x:Name="numFiles" Opacity="0.85"/>
            </StackPanel>
        </Border>

        <TreeView x:Name="treeView" Grid.Row="1"
                  Background="Transparent"
                  BorderThickness="0"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="0,1">
                        <Image Source="{Binding IconImage}" Width="16" Height="16" Margin="0,0,6,0"
                               Stretch="Uniform" SnapsToDevicePixels="True"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SizeText}" Margin="12,0,0,0" Opacity="0.6"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
