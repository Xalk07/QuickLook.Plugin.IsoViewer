<UserControl x:Class="QuickLook.Plugin.IsoViewer.PspIsoViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QuickLook.Plugin.IsoViewer"
             Background="{DynamicResource MainWindowBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="280"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="0.75*" MinHeight="180"/>
        </Grid.RowDefinitions>

        <!-- Верх: PBP-подобный просмотрщик (метаданные + картинки + звук/видео) -->
        <local:ViewerPane x:Name="pbpPane" Grid.Row="0"/>

        <GridSplitter Grid.Row="1"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="#444"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True"/>

        <!-- Низ: дерево файлов ISO -->
        <local:IsoFolderPanel x:Name="folderPane" Grid.Row="2"/>
    </Grid>
</UserControl>
